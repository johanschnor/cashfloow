{
  "name": "cashfloow",
  "version": "1.1.0",
  "description": "MCP server that gives Claude finished analyses of cash flow, receivables, sales and stock from e-conomic, in English or Danish.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cashfloow": "mcp-server.js"
  },
  "main": "mcp-server.js",
  "files": [
    "mcp-server.js",
    "server.js",
    "public/",
    "lib/",
    "manifest.json",
    "README.md",
    "LICENSE",
    ".env.example",
    "README.da.md"
  ],
  "scripts": {
    "start": "node mcp-server.js",
    "dashboard": "node server.js",
    "test": "node test/mcp.test.mjs",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "accounting",
    "cash-flow",
    "claude",
    "debitorer",
    "e-conomic",
    "inventory",
    "lagerstyring",
    "likviditet",
    "likviditetsprognose",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "regnskab"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2"
  }
}
