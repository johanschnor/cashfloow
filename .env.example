# Copy to .env and fill in. Without tokens, e-conomic's public demo account is used (very little data).
# Both tokens come from creating an app at e-conomic.com/developer and granting it access to your agreement.
# Never commit .env; it is in .gitignore.
ECONOMIC_APP_SECRET_TOKEN=
ECONOMIC_AGREEMENT_GRANT_TOKEN=
# "en" for English tools and answers, empty for Danish.
CASHFLOOW_LANG=
# Port for the local dashboard (npm run dashboard)
PORT=4400
