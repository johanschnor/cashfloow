# Kopiér til .env og udfyld. Uden disse bruges e-conomics offentlige demokonto (meget lidt data).
# Begge tokens fås ved at oprette en app i e-conomics udviklerportal og give den adgang til din aftale.
# .env må aldrig committes; den står i .gitignore.
ECONOMIC_APP_SECRET_TOKEN=
ECONOMIC_AGREEMENT_GRANT_TOKEN=
# Port til det lokale dashboard (npm run dashboard)
PORT=4400
